#!/usr/bin/env bash
# examine-image — one-shot vision inference via Ollama
#
# Usage: examine-image [OPTIONS] <image-path>
#
# Options:
#   --prompt TEXT    Prompt to send with the image (default: describe in detail)
#   --model MODEL    Ollama model (default: minimax-m3:cloud)
#   --host URL       Ollama base URL (default: http://127.0.0.1:11434)
#   --fallback       Try ollama-fallback/qwen3.8:27b if primary fails
#   --json           Print raw JSON response instead of just the text
#   --show-config    Print resolved config and exit
set -euo pipefail

PROMPT="Describe this image in detail."
MODEL="${EXAMINE_IMAGE_MODEL:-minimax-m3:cloud}"
HOST="${EXAMINE_IMAGE_HOST:-http://127.0.0.1:11434}"
FALLBACK_HOST="http://YOUR-HOST.YOUR-TAILNET.ts.net:11434"
FALLBACK_MODEL="qwen3.8:27b"
OUTPUT_JSON=0
USE_FALLBACK=0
SHOW_CONFIG=0
IMAGE_PATH=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prompt)    PROMPT="$2"; shift 2 ;;
    --model)     MODEL="$2"; shift 2 ;;
    --host)      HOST="$2"; shift 2 ;;
    --fallback)  USE_FALLBACK=1; shift ;;
    --json)      OUTPUT_JSON=1; shift ;;
    --show-config) SHOW_CONFIG=1; shift ;;
    -h|--help)
      grep '^#' "$0" | sed 's/^# \{0,1\}//' | tail -n +2
      exit 0 ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *)  IMAGE_PATH="$1"; shift ;;
  esac
done

if [[ "$SHOW_CONFIG" -eq 1 ]]; then
  echo "model:          $MODEL"
  echo "host:           $HOST"
  echo "fallback_host:  $FALLBACK_HOST"
  echo "fallback_model: $FALLBACK_MODEL"
  exit 0
fi

if [[ -z "$IMAGE_PATH" ]]; then
  echo "Usage: examine-image [OPTIONS] <image-path>" >&2
  exit 1
fi

if [[ ! -f "$IMAGE_PATH" ]]; then
  echo "ERROR: File not found: $IMAGE_PATH" >&2
  exit 1
fi

# Encode image as base64
B64=$(base64 "$IMAGE_PATH" | tr -d '\n')

call_ollama() {
  local host="$1" model="$2"
  local payload
  payload=$(printf '{"model":"%s","prompt":"%s","images":["%s"],"stream":false}' \
    "$model" \
    "$(echo "$PROMPT" | sed 's/"/\\"/g')" \
    "$B64")

  curl -sf --max-time 120 "$host/api/generate" \
    -H "Content-Type: application/json" \
    -d "$payload"
}

run() {
  local host="$1" model="$2"
  local resp
  if ! resp=$(call_ollama "$host" "$model" 2>&1); then
    echo "ERROR: Request to $host failed: $resp" >&2
    return 1
  fi

  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    echo "$resp"
    return 0
  fi

  # Extract .response field
  local text
  if command -v jq &>/dev/null; then
    text=$(echo "$resp" | jq -r '.response // empty')
  else
    text=$(echo "$resp" | grep -o '"response":"[^"]*"' | sed 's/"response":"//;s/"$//' | sed 's/\\n/\n/g')
  fi

  if [[ -z "$text" ]]; then
    echo "ERROR: Empty response from model" >&2
    return 1
  fi

  echo "$text"
}

if run "$HOST" "$MODEL"; then
  exit 0
fi

if [[ "$USE_FALLBACK" -eq 1 ]]; then
  echo "[primary failed, trying fallback: $FALLBACK_MODEL on $FALLBACK_HOST]" >&2
  run "$FALLBACK_HOST" "$FALLBACK_MODEL"
fi
